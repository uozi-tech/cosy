{
  "private": true,
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-legend": "^2.0.0",
    "vue": "^3.5.44"
  },
  "scripts": {
    "docs:sync": "mkdir -p docs/public/debug-app && cp -r debug/app/css debug/app/js debug/app/fonts debug/app/assets docs/public/debug-app/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "js-yaml": "5.5.0",
    "linkify-it": "^6.1.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "undici": "^8.12.3",
    "vite": "^8.3.5"
  }
}

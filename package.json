{
  "private": true,
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-legend": "^2.0.0",
    "vue": "^3.5.42"
  },
  "scripts": {
    "docs:sync": "mkdir -p docs/public/debug-app && cp -r debug/app/css debug/app/js debug/app/fonts debug/app/assets docs/public/debug-app/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "axios": "^1.20.0",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "js-yaml": "5.4.1",
    "linkify-it": "^6.1.0",
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "undici": "^8.10.1",
    "vite": "^8.2.2"
  }
}
